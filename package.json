{
  "name": "opencode-jev-free-router",
  "version": "0.1.0",
  "description": "Jev (System One) como juiz-roteador para free models do OpenCode Zen, com fallback em cadeia",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./tui": "./tui.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "node --test ./src/*.test.mjs",
    "evaluate:routing": "node ./scripts/evaluate-routing.mjs",
    "e2e:gateway": "node scripts/e2e-gateway.mjs",
    "e2e:matrix": "node scripts/e2e-multiround-matrix.mjs",
    "e2e:multiround-real": "node scripts/e2e-multiround-real.mjs",
    "e2e:context": "node scripts/e2e-context-management.mjs"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.7"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "typescript": "^5.6.0"
  }
}
