{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opjev.dev/schemas/routing-evaluation-fixture.schema.json",
  "title": "Routing evaluation fixture set",
  "description": "Deterministic offline cases for evaluating route and agent selection. Inputs deliberately exclude credentials and provider responses.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cases"],
  "properties": {
    "version": { "const": 1 },
    "description": { "type": "string" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "input", "expected"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "description": { "type": "string" },
        "category": { "enum": ["lane", "boundary", "fallback"] },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prompt"],
          "properties": {
            "prompt": { "type": "string", "minLength": 1 },
            "validAgents": { "type": "array", "items": { "type": "string" } },
            "freeCandidates": { "type": "array", "items": { "type": "string" } },
            "failure": { "enum": ["network", "timeout", "invalid-response", "invalid-route", "invalid-agent", "invalid-model"] }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["route", "agent", "via"],
          "properties": {
            "route": { "enum": ["fast-coding", "heavy-reasoning", "research-docs"] },
            "agent": { "type": "string", "minLength": 1 },
            "model": { "type": "string", "minLength": 1 },
            "via": { "enum": ["jev", "heuristic"] },
            "overridden": { "type": "boolean" },
            "fallbackReason": { "type": "string" }
          }
        }
      }
    }
  }
}
