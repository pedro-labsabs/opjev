{
  "$schema": "https://opencode.ai/config.json",
  // No OpenCode v2.0.11, o servidor do projeto (`opencode serve`) carrega os plugins declarados
  // no opencode.json do projeto, enquanto a interface CLI/TUI (`opencode`) carrega plugins TUI
  // a partir de ~/.config/opencode/plugins/<nome-do-plugin> (entrypoint ./tui).
  "plugins": [
    {
      "package": "opencode-jev-free-router",
      "options": {
        "jevModel": "jev-1.13-free",
        "jevEndpoint": "https://opencode.ai/zen/v1/systemone",
        "apiKeyEnv": "OPENCODE_API_KEY",
        "confidenceThreshold": 0.55,
        "enableAutoRoute": true,
        "jevTimeoutMs": 15000
      }
    }
  ]
}
